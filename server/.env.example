# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB Atlas) ----
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docseditz?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docseditz?retryWrites=true&w=majority

# MONGODB_URI=mongodb+srv://singhsiddharth4598_db_user:<ehZvgSRaiy6em2FY>@cluster0.fvlzwlt.mongodb.net/docseditz?retryWrites=true&w=majority

# mongodb+srv://singhsiddharth4598_db_user:<ehZvgSRaiy6em2FY>@cluster0.fvlzwlt.mongodb.net/docseditz?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://<singhsiddharth4598_db_user>:<iRqUgf5OvyxXOtMH>@cluster0.lpeuajg.mongodb.net/docseditz?retryWrites=true&w=majority
# username: singhsiddharth4598_db_user
# password: iRqUgf5OvyxXOtMH


# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Email (SMTP - e.g. Gmail app password, Resend, Mailtrap) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="DOCSEDITZ <no-reply@docseditz.com>"

# ---- Cloudinary storage ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Limits ----
MAX_FILE_SIZE_MB=50
FREE_STORAGE_MB=500
PRO_STORAGE_MB=10240
